# =============================================================================
# Egyptian Legal AI — configuration template
#
# Copy to .env and fill in secrets:   cp .env.example .env
#
# NEVER commit .env. This file contains no real secrets. Settings uses
# extra="ignore", so a MISSPELLED KEY IS SILENTLY DISCARDED — several past bugs
# (QDRANT_COLLECTION vs QDRANT_COLLECTION_NAME, duplicate METRICS_ENABLED) came
# from exactly that. Names below are verified against src/config/settings.py.
# =============================================================================

# ---------------------------------------------------------------- application
APP_NAME=Egyptian Legal AI
APP_ENV=development              # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
TIMEZONE=Africa/Cairo

# ---------------------------------------------------------------- http surface
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
# Public URL of the API, for links/docs only. Behind nginx leave it blank.
API_BASE_URL=

# ------------------------------------------------------------------------ CORS
# Comma-separated. Behind nginx (same origin) you can leave these empty.
# If you must expose the API directly to a browser on another origin:
#   CORS_ALLOW_ORIGIN_REGEX uses re.fullmatch, NOT re.search.
#   A dev-tunnel origin like https://abcd1234-3000.eun1.devtunnels.ms has TWO
#   dots before devtunnels, so it needs (\.[a-z0-9-]+)* — the single-segment
#   version silently matches nothing.
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_ORIGIN_REGEX=

# -------------------------------------------------------------------- security
JWT_SECRET_KEY=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ENABLED=true
# NOTE: tokens are not revocable. Logout is client-side only. See docs/SECURITY.md.

# ------------------------------------------------------------------ postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=egyptian_legal_ai
POSTGRES_USER=legal_ai_user
POSTGRES_PASSWORD=
# Full URL wins over the parts above. docker-compose builds its own with host=postgres.
DATABASE_URL=postgresql+psycopg://legal_ai_user:CHANGE_ME@localhost:5432/egyptian_legal_ai
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ---------------------------------------------------------------------- qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Only QDRANT_COLLECTION_NAME is read by the store. QDRANT_COLLECTION is a legacy
# alias kept in settings.py; setting both to different values is a silent footgun.
QDRANT_COLLECTION_NAME=egyptian_legal

# ----------------------------------------------------------------------- redis
# DEAD CONFIG TODAY: CACHE_ENABLED=false and the redis driver is not installed.
# factory.py never builds a cache. Enable only after implementing answer caching.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
CACHE_DEFAULT_TTL=3600

# ----------------------------------------------------------------- llm routing
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=transformers
# Leave EMPTY to disable the local 3B fallback entirely. ProviderRouter used to
# force-append "transformers"; it no longer does. A 3B model on CPU is minutes
# per answer and ~6 GB RAM (does not fit in your 4 GB P2000).
LLM_FALLBACK_ORDER=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
CONTEXT_MAX_TOKENS=1500

# ------------------------------------------------------------------ providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --------------------------------------------------------- local transformers
# Kept CPU-only deliberately. bitsandbytes 4-bit requires Turing+ (sm_75+);
# your Quadro P2000 is Pascal sm_61.
LOCAL_MODEL_NAME=
LOCAL_MODEL_DEVICE=cpu
LOCAL_MODEL_DTYPE=auto
LOCAL_MODEL_LOAD_IN_4BIT=false
LOCAL_MODEL_MAX_NEW_TOKENS=512

# ----------------------------------------------------------------- embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------ retrieval
RETRIEVAL_TOP_K=20
RERANKER_TOP_K=5
DENSE_RETRIEVAL_ENABLED=true
SPARSE_RETRIEVAL_ENABLED=true
HYBRID_FUSION_METHOD=rrf
RRF_K=60

# ------------------------------------------------------------------ reranking
# Set false until you have confirmed a real logit spread in the log line
# "RERANK RAW | logit_min=... | logit_max=...". A flat 0.5000 floor means the
# cross-encoder is contributing no signal while costing ~8.5 s per question.
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# -------------------------------------------------------------------- chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNKING_STRATEGY=legal
PRESERVE_LEGAL_ARTICLE_BOUNDARIES=true

# ----------------------------------------------------------------------- paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
OFFICIAL_LAWS_DIR=data/raw/official_laws
USER_UPLOADS_DIR=data/raw/user_uploads
PROCESSED_DATA_DIR=data/processed
EVALUATION_DATA_DIR=data/evaluation
TEMP_DATA_DIR=data/temp
ARTIFACTS_DIR=artifacts
EMBEDDINGS_DIR=artifacts/embeddings
MODELS_DIR=artifacts/models
INDEXES_DIR=artifacts/indexes
LOGS_DIR=logs
DOCUMENT_STORAGE_DIR=data/documents

# -------------------------------------------------------- legal answer policy
REQUIRE_CITATIONS=true
ALLOW_ANSWERS_WITHOUT_SOURCES=false
SHOW_SOURCE_METADATA=true
DISTINGUISH_USER_UPLOADS_FROM_OFFICIAL_LAWS=true
LEGAL_DISCLAIMER_ENABLED=true

# -------------------------------------------------------------------------- ocr
# OCR_ENABLED=true requires paddleocr installed. The default Docker images do
# NOT include it (INSTALL_OCR=0). Either build with INSTALL_OCR=1 or set false.
OCR_ENABLED=false
OCR_LANGUAGE=ara+eng
OCR_ENGINE=paddleocr

# ----------------------------------------------------------------- monitoring
METRICS_ENABLED=false
MONITORING_EXPORT_PATH=logs/metrics.jsonl
TRACING_ENABLED=false

# -------------------------------------------------------------------- workers
# true  -> worker runs inside the API process (4 containers, simpler)
# false -> run `docker compose --profile worker up` (5 containers, isolated)
WORKER_ENABLED=true
WORKER_EMBEDDED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_MAX_RETRIES=2
WORKER_RETRY_BACKOFF_SECONDS=30
WORKER_RECLAIM_STALE_AFTER_SECONDS=600
WORKER_JOB_STORE=sql

# ---------------------------------------------------------------- hugging face
# Only needed for gated/private models. Public models download anonymously.
HF_TOKEN=

# ============================================================ FRONTEND (web/)
# These are read by Next.js at BUILD time and inlined into the JS bundle.
# Changing them requires rebuilding the web image.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_AUTH_DISABLED=false
NEXT_PUBLIC_API_TIMEOUT_MS=45000
NEXT_PUBLIC_API_HEALTH_TIMEOUT_MS=20000
NEXT_PUBLIC_API_CHAT_TIMEOUT_MS=300000
NEXT_PUBLIC_API_UPLOAD_TIMEOUT_MS=600000
NEXT_PUBLIC_API_MAX_CONCURRENCY=4
NEXT_PUBLIC_POLL_INTERVAL_MS=8000
NEXT_PUBLIC_HEALTH_POLL_INTERVAL_MS=30000

# Compose-only: PUBLIC_ORIGIN is the URL users type, e.g. https://mizan.example
PUBLIC_ORIGIN=http://localhost
PUBLIC_PORT=80