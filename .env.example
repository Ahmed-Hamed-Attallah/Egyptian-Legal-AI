# ── Application ──────────────────────────────
APP_NAME=Egyptian Legal AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Africa/Cairo

# ── FastAPI ──────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGIN_REGEX=

# ── Security ─────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_ENABLED=true

# ── PostgreSQL ───────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=egyptian_legal_ai
POSTGRES_USER=legal_ai_user
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://legal_ai_user:@localhost:5432/egyptian_legal_ai

# ── Qdrant ───────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=egyptian_legal

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false

# ── LLM ──────────────────────────────────────
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_ORDER=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOCAL_MODEL_NAME=
LOCAL_MODEL_DEVICE=cpu
LOCAL_MODEL_LOAD_IN_4BIT=false
HF_TOKEN=

# ── Embeddings ───────────────────────────────
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=768

# ── Retrieval / Reranking ────────────────────
RETRIEVAL_TOP_K=20
RERANKER_TOP_K=5
RERANKER_ENABLED=false
DENSE_RETRIEVAL_ENABLED=true
SPARSE_RETRIEVAL_ENABLED=true
HYBRID_FUSION_METHOD=rrf
RRF_K=60
RERANKING_MODEL_NAME=BAAI/bge-reranker-base
RERANKING_DEVICE=cpu

# ── Chunking ─────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNKING_STRATEGY=legal

# ── Monitoring ───────────────────────────────
METRICS_ENABLED=false
TRACING_ENABLED=false

# ── Workers ──────────────────────────────────
WORKER_ENABLED=true
WORKER_EMBEDDED=true
WORKER_CONCURRENCY=2