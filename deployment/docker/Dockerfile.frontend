# syntax=docker/dockerfile:1.6
# =============================================================================
# Egyptian Legal AI — Next.js (web/) image
#
# Build context MUST be the repository root:
#   docker build -f deployment/docker/Dockerfile.frontend -t mizan-web .
#
# Requires `output: "standalone"` in web/next.config.mjs.
#
# NEXT_PUBLIC_* and rewrites are resolved at BUILD time, not runtime. Changing
# them requires a rebuild — that is how a dev-tunnel URL once got baked into a
# production bundle.
# =============================================================================

FROM node:20-alpine AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci

# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./

# App Router serves favicon.ico from src/app; a public/ dir may not exist.
# Create it so the runtime COPY below always has a source.
RUN mkdir -p public

# Server-side proxy target — consumed by next.config.mjs rewrites() at build.
ARG BACKEND_URL=http://api:8000
ENV BACKEND_URL=${BACKEND_URL}

ARG NEXT_PUBLIC_API_BASE_URL=/api/v1
ARG NEXT_PUBLIC_AUTH_DISABLED=false
ARG NEXT_PUBLIC_POLL_INTERVAL_MS=8000
ARG NEXT_PUBLIC_HEALTH_POLL_INTERVAL_MS=30000
ARG NEXT_PUBLIC_API_MAX_CONCURRENCY=4

ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_PUBLIC_AUTH_DISABLED=${NEXT_PUBLIC_AUTH_DISABLED} \
    NEXT_PUBLIC_POLL_INTERVAL_MS=${NEXT_PUBLIC_POLL_INTERVAL_MS} \
    NEXT_PUBLIC_HEALTH_POLL_INTERVAL_MS=${NEXT_PUBLIC_HEALTH_POLL_INTERVAL_MS} \
    NEXT_PUBLIC_API_MAX_CONCURRENCY=${NEXT_PUBLIC_API_MAX_CONCURRENCY}

RUN npm run build

# ---------------------------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000

# Alpine has no curl; Node 20 has global fetch.
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]